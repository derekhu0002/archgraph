{
"name": "Process Cooperation Viewpoint",
"description": "表达多个 Agent 角色之间为完成同一任务而进行的协作流程（ArchiMate 流程协作视角）。",
"elements": [
{
"id": "1336",
"name": "gpt-researcher-research-program"
,"type": "Course of Action"
,"description": "GPT-Researcher 多 Agent 研究主流程：从研究查询到发布报告的整体计划（Plan-and-Solve + RAG，参考 STORM 论文）。"
},
{
"id": "1337",
"name": "Plan Research"
,"type": "Business Process"
,"description": "规划研究：将研究查询分解为一组子问题，形成研究大纲。"
},
{
"id": "1338",
"name": "Conduct Sub-research"
,"type": "Business Process"
,"description": "执行子研究：并行抓取每个子问题相关的网络/本地文档信息，总结并追踪来源。"
},
{
"id": "1339",
"name": "Write Report"
,"type": "Business Process"
,"description": "撰写报告：过滤并聚合各子研究摘要，撰写研究报告草稿。"
},
{
"id": "1340",
"name": "Review Report"
,"type": "Business Process"
,"description": "评审报告：审阅草稿，检查事实准确性、客观性与引用完整性，给出修改意见。"
},
{
"id": "1341",
"name": "Publish Report"
,"type": "Business Process"
,"description": "发布报告：生成最终报告，输出 Markdown/PDF/Docx 等格式。"
},
{
"id": "1342",
"name": "Planner"
,"type": "Business Role"
,"description": "规划者：生成研究问题与研究大纲。"
},
{
"id": "1343",
"name": "Researcher"
,"type": "Business Role"
,"description": "研究员：并行收集各子问题的信息并溯源。"
},
{
"id": "1344",
"name": "Editor"
,"type": "Business Role"
,"description": "编辑：聚合摘要并撰写报告。"
},
{
"id": "1345",
"name": "Reviewer"
,"type": "Business Role"
,"description": "审稿人：评审草稿并提出修改意见。"
},
{
"id": "1346",
"name": "Publisher"
,"type": "Business Role"
,"description": "发布者：输出最终研究报告。"
},
{
"id": "1347",
"name": "Research Report"
,"type": "Deliverable"
,"description": "研究报告：包含引用来源的最终报告（Markdown/PDF/Docx）。"
},
{
"id": "1348",
"name": "Produce objective research report"
,"type": "Goal"
,"description": "产出客观、事实性、带引用的研究报告。"
},
{
"id": "1349",
"name": "Cite every fact with source"
,"type": "Constraint"
,"description": "局部约束：报告中每个事实必须附引用来源（作用于 Conduct Sub-research）。"
},
{
"id": "1350",
"name": "Reduce bias and hallucination"
,"type": "Principle"
,"description": "全局约束：通过多源抓取与交叉验证减少偏见与幻觉。"
}
],
